---
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/bebas-neue/400.css";
import "@fontsource/new-rocker/400.css";
import "../styles/global.css";

interface Props {
  titre?: string;
  description?: string;
}

const {
  titre = "Dernières Séances — Halloween 2026 au Château de Sucy",
  description =
    "28 oct. – 1er nov. 2026, Château de Sucy-en-Brie. Trois expériences pour petits et grands. Pré-réservez votre nuit, sans payer.",
} = Astro.props;

const site = "https://dernieresseances.fr";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />

    <meta name="theme-color" content="#071525" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dernières Séances" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}/assets/chateau-desktop.webp`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="/assets/titre-dernieres-seances.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>
