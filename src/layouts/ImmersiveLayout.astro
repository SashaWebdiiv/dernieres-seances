---
// Inter variable pour le romain (toutes les graisses en un fichier). L'italique n'existe qu'en
// 400 sur le site : fichier statique deux fois plus léger que l'italique variable.
import "@fontsource-variable/inter/wght.css";
import interItalique from "@fontsource/inter/files/inter-latin-400-italic.woff2?url";
import "@fontsource/new-rocker/400.css";
import "@fontsource/bebas-neue/400.css";
import "../styles/immersive.css";
import CookieBanner from "../components/consent/CookieBanner.astro";
import ogImage from "../assets/scenes/facade-desktop.webp";
import { getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  /** Tant que le site immersif n'est pas public, la page ne doit pas être indexée. */
  noindex?: boolean;
  /** Données structurées schema.org de la page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Format recommandé par Facebook, LinkedIn et X : 1200 × 630 (1,91:1).
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);
const ogAlt = "La façade du Château de Sucy illuminée, sous une pleine lune.";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#090909" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dernières Séances" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")} />
      )
    }

    <style is:inline
      set:html={`@font-face{font-family:"Inter Variable";font-style:italic;font-weight:400;font-display:swap;src:url(${interItalique}) format("woff2")}`}
    ></style>

    <!-- Active les états « amélioration progressive » (contenus empilés, menu replié) avant le rendu. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body class="antialiased">
    <slot />
    <CookieBanner />
  </body>
</html>
