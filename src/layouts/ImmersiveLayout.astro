---
// Inter variable pour le romain (toutes les graisses en un fichier). L'italique n'existe qu'en
// 400 sur le site : fichier statique deux fois plus léger que l'italique variable.
import "@fontsource-variable/inter/wght.css";
import interItalique from "@fontsource/inter/files/inter-latin-400-italic.woff2?url";
import "@fontsource/new-rocker/400.css";
import "@fontsource/bebas-neue/400.css";
import "../styles/immersive.css";
import CookieBanner from "../components/consent/CookieBanner.astro";
import ogImage from "../assets/partage/og-dernieres-seances.webp";
import { getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  /** Tant que le site immersif n'est pas public, la page ne doit pas être indexée. */
  noindex?: boolean;
  /** Données structurées schema.org de la page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Visuel de partage fourni par l'association (titre sur la façade). Format recommandé par Facebook,
// LinkedIn et X : 1200 × 630 (1,91:1).
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);
const ogAlt = "Dernières Séances — Oserez-vous entrer ? Le titre sur la façade du Château de Sucy, la nuit.";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#090909" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dernières Séances" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")} />
      )
    }

    <style is:inline
      set:html={`@font-face{font-family:"Inter Variable";font-style:italic;font-weight:400;font-display:swap;src:url(${interItalique}) format("woff2")}`}
    ></style>

    <!-- Active les états « amélioration progressive » (contenus empilés, menu replié) avant le rendu. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!--
      Hauteur d'écran figée (--ecran), utilisée par les scènes à la place de 100lvh.
      Dans Edge et Chrome sur iPhone (et les navigateurs intégrés aux applis), replier la barre
      d'outils redimensionne la page : 100lvh change, et toutes les scènes (plusieurs écrans de
      haut chacune) avec. 80 px de barre déplaçaient la billetterie de 840 px.
      Écran tactile : hauteur de l'écran physique (les décors couvrent toujours tout), recalculée
      seulement si la largeur change (rotation). Souris : hauteur de la fenêtre, à chaque
      redimensionnement.
    -->
    <script is:inline>
      (function () {
        var racine = document.documentElement;
        var tactile = window.matchMedia("(pointer: coarse)");
        var largeur = window.innerWidth;
        function mesurer() {
          var hauteur = window.innerHeight;
          if (tactile.matches) {
            var paysage = window.innerWidth > window.innerHeight;
            var cote = paysage ? Math.min(screen.width, screen.height) : Math.max(screen.width, screen.height);
            hauteur = Math.max(hauteur, cote);
          }
          racine.style.setProperty("--ecran", hauteur + "px");
        }
        mesurer();
        window.addEventListener("resize", function () {
          if (tactile.matches && window.innerWidth === largeur) return;
          largeur = window.innerWidth;
          mesurer();
        });
      })();
    </script>
  </head>

  <body class="antialiased">
    <slot />
    <CookieBanner />
  </body>
</html>
