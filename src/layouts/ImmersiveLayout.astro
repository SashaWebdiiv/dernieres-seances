---
import "@fontsource/inter/400.css";
import "@fontsource/inter/400-italic.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/new-rocker/400.css";
import "@fontsource/bebas-neue/400.css";
import "@fontsource/eb-garamond/400.css";
import "../styles/immersive.css";
import ogImage from "../assets/scenes/facade-desktop.webp";
import { getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  /** Tant que le site immersif n'est pas public, la page ne doit pas être indexée. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogImage, width: 1200, height: 750, format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#090909" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dernières Séances" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Active les états « amélioration progressive » (contenus empilés, menu replié) avant le rendu. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body class="antialiased">
    <slot />
  </body>
</html>
