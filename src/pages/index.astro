---
import ImmersiveLayout from "../layouts/ImmersiveLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import HeroScene from "../components/scenes/HeroScene.astro";
import CalendarScene from "../components/scenes/CalendarScene.astro";
import PartnersScene from "../components/scenes/PartnersScene.astro";
import PresentationScene from "../components/scenes/PresentationScene.astro";
import ExperienceScene from "../components/scenes/ExperienceScene.astro";
import TicketScene from "../components/scenes/TicketScene.astro";
import ParadeScene from "../components/scenes/ParadeScene.astro";
import FaqScene from "../components/scenes/FaqScene.astro";
import TransitionOverlay from "../components/ui/TransitionOverlay.astro";
import StickyCta from "../components/ui/StickyCta.astro";
import { getImage } from "astro:assets";
import facade from "../assets/scenes/facade-desktop.webp";
import { eventJsonLd } from "../data/seo";

/*
 * Page d'accueil : le site immersif. Il a remplacé la page d'attente (pré-réservations) au
 * lancement de la billetterie ; l'ancienne adresse /visite redirige ici (vercel.json).
 * Les QR codes des flyers pointent sur / .
 */

// Google recommande trois formats d'image (16:9, 4:3, 1:1) pour les résultats « Événements ».
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const eventImages = await Promise.all(
  [
    [1600, 900],
    [1600, 1200],
    [1200, 1200],
  ].map(async ([width, height]) => {
    const image = await getImage({ src: facade, width, height, format: "jpg" });
    return new URL(image.src, Astro.site);
  }),
);
---

<ImmersiveLayout
  title="Dernières Séances — Halloween 2026 au Château de Sucy"
  description="Du 28 octobre au 1er novembre 2026, visitez un château un peu trop vivant : parcours immersif, expérience horrifique et parade à Sucy-en-Brie."
  jsonLd={eventJsonLd(pageUrl, eventImages)}
>
  <Navbar />
  <main id="contenu" tabindex="-1">
    <HeroScene />
    <CalendarScene />
    <PartnersScene />
    <PresentationScene />
    <ExperienceScene />
    <TicketScene />
    <ParadeScene />
    <FaqScene>
      <Footer />
    </FaqScene>
  </main>
  <StickyCta />
  <TransitionOverlay />
</ImmersiveLayout>

<script>
  import "../scripts/main";
</script>
