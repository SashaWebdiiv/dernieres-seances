---
import ImmersiveLayout from "../layouts/ImmersiveLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import HeroScene from "../components/scenes/HeroScene.astro";
import CalendarScene from "../components/scenes/CalendarScene.astro";
import PartnersScene from "../components/scenes/PartnersScene.astro";
import PresentationScene from "../components/scenes/PresentationScene.astro";
import ExperienceScene from "../components/scenes/ExperienceScene.astro";
import TicketScene from "../components/scenes/TicketScene.astro";
import FaqScene from "../components/scenes/FaqScene.astro";
import TransitionOverlay from "../components/ui/TransitionOverlay.astro";

/*
 * Site immersif en construction. Il vit sur /visite pour ne pas toucher à la page d'attente
 * servie sur / (QR codes des flyers) ; il prendra sa place au lancement.
 */
---

<ImmersiveLayout
  title="Dernières Séances — Halloween 2026 au Château de Sucy"
  description="Du 28 octobre au 1er novembre 2026, visitez un château un peu trop vivant : parcours immersif, expérience horrifique, jardin ensorcelé et parade au Château de Sucy-en-Brie."
  noindex
>
  <Navbar />
  <main id="contenu" tabindex="-1">
    <HeroScene />
    <CalendarScene />
    <PartnersScene />
    <PresentationScene />
    <ExperienceScene />
    <TicketScene />
    <FaqScene>
      <Footer />
    </FaqScene>
  </main>
  <TransitionOverlay />
</ImmersiveLayout>

<script>
  import "../scripts/main";
</script>
