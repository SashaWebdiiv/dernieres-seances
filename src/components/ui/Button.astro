---
import type { HTMLAttributes } from "astro/types";

/** Lien si `href` est fourni (navigation), vrai `<button>` sinon (action). */
interface Props extends Omit<HTMLAttributes<"a">, "class" | "type"> {
  variant?: "primary" | "secondary";
  type?: "button" | "submit";
  class?: string;
}

const { variant = "primary", class: className, href, type = "button", ...rest } = Astro.props;

const classes = [
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-6 text-sm font-semibold uppercase tracking-wider transition-colors",
  variant === "primary"
    ? "bg-ink text-veil hover:bg-ink-muted"
    : "border border-line text-ink hover:bg-ink/10",
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
