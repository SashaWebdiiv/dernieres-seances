---
import { domainesMesures, dureeChoixJours, dureeCookiesSecondes, gaMeasurementId } from "../../data/analytics";

/**
 * Bandeau de consentement à la mesure d'audience (voir `scripts/consent.ts`). N'existe que si
 * Google Analytics est configuré ; masqué sans JavaScript (et alors rien n'est mesuré).
 * « Tout refuser » et « Tout accepter » ont le même poids visuel (CNIL).
 */
const bouton =
  "inline-flex min-h-11 flex-1 items-center justify-center rounded-lg border border-creme/40 px-4 text-sm font-semibold text-creme transition-colors hover:border-creme hover:bg-creme/10 sm:flex-none";
---

{
  gaMeasurementId && (
    <section
      class="fixed inset-x-0 bottom-0 z-60 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-5.5"
      aria-label="Consentement aux cookies"
      tabindex="-1"
      data-cookies
      data-ga-id={gaMeasurementId}
      data-domaines={JSON.stringify(domainesMesures)}
      data-duree-choix={dureeChoixJours}
      data-duree-cookies={dureeCookiesSecondes}
      hidden
    >
      <div class="mx-auto flex max-w-230 flex-col gap-4 rounded-lg border border-sable/25 bg-noir/95 p-4 text-sm leading-relaxed text-sable/85 shadow-[0_8px_40px_rgb(0_0_0/0.7)] backdrop-blur sm:p-5 md:flex-row md:items-center md:gap-6">
        <p class="flex-1">
          <strong class="font-semibold text-creme">Mesure d'audience.</strong> Avec votre accord, nous utilisons
          Google Analytics pour savoir combien de personnes visitent le site et comment elles l'utilisent. Refuser
          ne change rien à votre visite ni à la billetterie.{" "}
          <a href="/confidentialite/#cookies" class="text-ambre underline underline-offset-3 hover:text-ambre-clair">
            En savoir plus
          </a>
        </p>
        <div class="flex shrink-0 gap-3">
          <button type="button" class={bouton} data-cookies-refuser>Tout refuser</button>
          <button type="button" class={bouton} data-cookies-accepter>Tout accepter</button>
        </div>
      </div>
    </section>
  )
}

<script>
  import { initConsentement } from "../../scripts/consent";

  initConsentement();
</script>
