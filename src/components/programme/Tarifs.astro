---
import type { Tarif } from "../../data/programme";

/** Étiquettes de prix (maquette « Prix-tag », 158:5995). */
interface Props {
  tarifs: Tarif[];
}

const { tarifs } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    tarifs.map((tarif) => (
      <li class="flex items-center gap-1.5 rounded border border-sable/15 bg-sable/8 px-2.5 py-1">
        <span class="text-[10px] tracking-[1px] text-sable/60 uppercase">{tarif.label}</span>
        <span class="text-[11px] font-semibold text-creme">{tarif.prix}</span>
      </li>
    ))
  }
</ul>
