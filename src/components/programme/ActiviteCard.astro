---
import type { Activite } from "../../data/programme";

/** Carte d'activité (maquette 88:55). */
interface Props {
  activite: Activite;
}

const { activite } = Astro.props;
---

<article class="flex flex-col gap-4 border border-sable/15 bg-noir/40 p-5">
  <header class="flex flex-col-reverse items-start gap-3 sm:flex-row sm:justify-between">
    <div class="flex max-w-81 flex-col gap-1">
      <h3 class="text-lg leading-5.5 font-semibold text-creme">{activite.titre}</h3>
      <p class="text-[11px] leading-4 text-sable/60">{activite.description}</p>
    </div>
    <p class="shrink-0 bg-ambre px-3 py-2 text-[9.6px] leading-[14.4px] tracking-[0.2px] text-noir uppercase">
      {activite.public}
    </p>
  </header>

  <p class="text-[12.8px] leading-4.5 text-ambre">
    {activite.horaires.map((ligne, index) => (index === 0 ? ligne : [<br />, ligne]))}
  </p>

  <ul class="flex flex-wrap gap-2">
    {
      activite.tarifs.map((tarif) => (
        <li class="flex items-center gap-1.5 border border-sable/15 bg-sable/8 px-2.5 py-1">
          <span class="text-[10px] tracking-[1px] text-sable/60 uppercase">{tarif.label}</span>
          <span class="text-[11px] font-semibold text-creme">{tarif.prix}</span>
        </li>
      ))
    }
  </ul>

  {activite.note && <p class="text-[11px] leading-4 text-brun italic">{activite.note}</p>}
</article>
