---
import Tarifs from "./Tarifs.astro";
import type { Activite } from "../../data/programme";

/** Carte d'activité (maquette 158:5986) : description à gauche, horaires à droite sur desktop. */
interface Props {
  activite: Activite;
}

const { activite } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-lg border border-sable/15 bg-noir/40 p-5">
  <header class="flex flex-col-reverse items-start gap-3 sm:flex-row sm:justify-between">
    <h3 class="text-lg leading-5.5 font-semibold text-creme">{activite.titre}</h3>
    <p class="shrink-0 rounded bg-ambre px-3 py-2 text-sm leading-[14.4px] font-bold tracking-[0.2px] text-noir uppercase">
      {activite.public}
    </p>
  </header>

  <div class="flex flex-col gap-2.5 md:flex-row md:items-center md:justify-between">
    <p class="text-sm leading-4 text-sable/60 md:max-w-119.5">{activite.description}</p>
    <p class="text-sm leading-4.5 text-ambre md:w-119.5">
      {activite.horaires.map((ligne, index) => (index === 0 ? ligne : [<br />, ligne]))}
    </p>
  </div>

  <Tarifs tarifs={activite.tarifs} />

  {activite.note && <p class="text-[11px] leading-4 text-brun italic">{activite.note}</p>}
</article>
