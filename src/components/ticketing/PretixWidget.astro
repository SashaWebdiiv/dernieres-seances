---
/**
 * Widget officiel Pretix (produits, panier, checkout). Le paiement Stripe est configuré
 * côté Pretix : aucun traitement de paiement n'a lieu sur ce site.
 *
 * Le script et la feuille de style Pretix ne sont chargés qu'à l'approche de la section,
 * jamais au chargement de la page. Selon le navigateur (cookies tiers bloqués, petit écran)
 * ou le moyen de paiement, Pretix peut ouvrir le checkout dans un nouvel onglet ou rediriger
 * vers une page externe (3-D Secure) : le retour vers ce site se règle dans Pretix,
 * pas ici. La section reste atteignable directement par `#billetterie`.
 */
interface Props {
  /** Boutique Pretix de l'événement, avec le « / » final. `null` : encart d'attente. */
  shopUrl: string | null;
  /** Force le checkout sur le site Pretix au lieu de la fenêtre intégrée. */
  disableIframe?: boolean;
}

const { shopUrl, disableIframe = false } = Astro.props;
const widget = shopUrl && {
  script: new URL("/widget/v1.fr.js", shopUrl).href,
  stylesheet: new URL("widget/v1.css", shopUrl).href,
};
---

<div class="pretix-host rounded-lg bg-surface p-6 md:p-8">
  {
    shopUrl && widget ? (
      <div data-pretix data-script={widget.script} data-stylesheet={widget.stylesheet}>
        <pretix-widget event={shopUrl} disable-iframe={disableIframe ? "" : undefined} />
        <noscript>
          <p>
            La billetterie nécessite JavaScript.{" "}
            <a href={shopUrl} target="_blank" rel="noopener" class="underline">
              Ouvrir la billetterie dans un nouvel onglet
            </a>
            .
          </p>
        </noscript>
      </div>
    ) : (
      <p class="text-ink-muted">
        [Emplacement du widget Pretix — renseigner <code>pretixShopUrl</code> dans{" "}
        <code>src/data/billetterie.ts</code>.]
      </p>
    )
  }
</div>

<script>
  const hosts = document.querySelectorAll<HTMLElement>("[data-pretix]");

  function loadPretix(host: HTMLElement): void {
    const { script, stylesheet } = host.dataset;
    if (!script || !stylesheet || document.querySelector(`script[src="${script}"]`)) return;

    const link = Object.assign(document.createElement("link"), { rel: "stylesheet", href: stylesheet });
    const tag = Object.assign(document.createElement("script"), { src: script, async: true });
    document.head.append(link, tag);
  }

  if (hosts.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          loadPretix(entry.target as HTMLElement);
        }
      },
      { rootMargin: "150% 0px" },
    );
    hosts.forEach((host) => observer.observe(host));
  }
</script>
