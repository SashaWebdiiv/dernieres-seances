---
// Section 3 — « Pré-réservation » (Figma : desktop 10:615 / mobile 4:391)
import FormulairePreReservation from "./FormulairePreReservation.astro";
import { emailContact } from "../data/evenement";

const reperes = [
  "Aucun paiement maintenant",
  "Priorité à l’ouverture de la billetterie",
  "Coordonnées protégées",
];
---

<section class="prereservation">
  <div class="prereservation__contenu">
    <div class="intro">
      <p class="intro__surtitre">Priorité billetterie</p>
      <h2 class="intro__titre">Pré-réservez votre nuit au Château</h2>
      <p class="intro__description">
        Laissez-nous vos coordonnées en moins d’une minute. Vous serez averti·e en priorité à
        l’ouverture de la billetterie.
      </p>

      <ul class="reperes-liste">
        {
          reperes.map((r) => (
            <li class="repere">
              <svg class="repere__icone" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  d="M3 8.5 6.5 12 13 4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {r}
            </li>
          ))
        }
      </ul>
    </div>

    <FormulairePreReservation />
  </div>

  <footer class="pied">
    <p class="pied__partenaire">Restauration sur place</p>
    <p class="pied__contact">
      Un doute ? <a href={`mailto:${emailContact}`}>{emailContact}</a>
    </p>

    <div class="pied__logos">
      <img src="/assets/logo-compagnie.png" alt="L'Acompagnie Improvisée" width="360" height="172" />
      <img src="/assets/logo-sucy.png" alt="Sucy-en-Brie" width="226" height="88" />
    </div>

    <p class="pied__credit">
      Site développé par <a href="https://webdiiv.com" target="_blank" rel="noopener">Webdiiv</a>
    </p>
  </footer>
</section>

<style>
  /* ───────── Mobile (référence Figma : 390 × 993) ───────── */
  .prereservation {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px var(--marge-mobile) 36px;
    background: var(--nuit-700);
  }

  .prereservation__contenu {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ── Introduction ── */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .intro__surtitre {
    color: var(--ambre);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.21;
    text-transform: uppercase;
  }

  .intro__titre {
    color: var(--creme);
    font-family: var(--fonte-titre);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.08;
  }

  .intro__description {
    color: var(--brume);
    font-size: 14px;
    line-height: 1.55;
  }

  /* Repères absents de la maquette mobile. */
  .reperes-liste { display: none; }

  /* ── Pied de page ── */
  .pied {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .pied__partenaire,
  .pied__contact,
  .pied__credit {
    margin: 0;
    color: var(--brume);
    line-height: 1.21;
  }

  .pied__partenaire { font-size: 11px; }

  .pied__contact,
  .pied__credit { font-size: 10px; }

  .pied__contact a,
  .pied__credit a {
    color: inherit;
    text-decoration-color: rgb(184 196 204 / 0.4);
    text-underline-offset: 2px;
  }

  .pied__contact a:hover,
  .pied__credit a:hover { color: var(--ambre-clair); }

  .pied__logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .pied__logos img:first-child {
    width: 82px;
    height: 39px;
  }

  .pied__logos img:last-child {
    width: 82px;
    height: 32px;
  }

  /* ───────── Desktop (référence Figma : 1440 × 817) ───────── */
  @media (min-width: 900px) {
    .prereservation {
      align-items: center;
      gap: 64px;
      padding: 96px 120px 52px;
    }

    .prereservation__contenu {
      flex-direction: row;
      align-items: flex-start;
      gap: 96px;
      width: 100%;
      max-width: 1200px;
    }

    .intro {
      flex: none;
      gap: 18px;
      width: 480px;
    }

    .intro__titre {
      font-size: 58px;
      line-height: 1.04;
    }

    .intro__description { font-size: 16px; line-height: 1.6; }

    .reperes-liste {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 0;
      padding: 20px 0 0;
      list-style: none;
    }

    .repere {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--menthe);
      font-size: 13px;
      line-height: 1.21;
    }

    .repere__icone {
      flex: none;
      width: 14px;
      height: 14px;
    }

    :global(.prereservation__contenu > .formulaire) { flex: 1; min-width: 0; }

    .pied {
      gap: 18px;
      width: 100%;
      max-width: 1200px;
    }

    .pied__logos img:first-child {
      width: 113px;
      height: 54px;
    }

    .pied__logos img:last-child {
      width: 113px;
      height: 44px;
    }
  }
</style>
