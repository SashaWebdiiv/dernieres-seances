---
/**
 * PLACEHOLDER. Le design et le comportement du calendrier sont définis dans la maquette
 * Figma Design : ce composant ne fixe que la donnée d'entrée (les jours, en ISO) et un
 * rendu sémantique minimal, à remplacer lors de l'intégration.
 */
interface Props {
  days: readonly string[];
}

const { days } = Astro.props;

const format = new Intl.DateTimeFormat("fr-FR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  timeZone: "Europe/Paris",
});
// Midi UTC : la date reste la même quel que soit le fuseau appliqué au formatage.
const label = (iso: string) => format.format(new Date(`${iso}T12:00:00Z`));
---

<div class="flex flex-col gap-4 rounded-lg bg-surface p-6" data-calendar>
  <ol class="grid gap-2 sm:grid-cols-5">
    {
      days.map((day) => (
        <li class="rounded border border-line p-3 text-center first-letter:uppercase">
          <time datetime={day}>{label(day)}</time>
        </li>
      ))
    }
  </ol>
  <p class="text-sm text-ink-muted">[Calendrier provisoire — à intégrer depuis la maquette Figma Design.]</p>
</div>
