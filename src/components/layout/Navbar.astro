---
import Button from "../ui/Button.astro";
import { navLinks, reserveLink } from "../../data/navigation";
---

<a
  href="#contenu"
  class="sr-only z-110 rounded bg-ink px-4 py-2 text-veil focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  Aller au contenu
</a>

<header class="fixed inset-x-0 top-0 z-50 bg-linear-to-b from-veil/80 to-transparent">
  <nav aria-label="Navigation principale" class="relative flex items-center justify-between gap-4 px-4 py-3 md:px-8">
    <a href="#accueil" class="font-semibold tracking-wide" data-jump>Dernières Séances</a>

    <button
      type="button"
      class="hidden min-h-11 rounded-full border border-line px-4 text-sm font-semibold max-md:[.js_&]:inline-flex max-md:[.js_&]:items-center"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      Menu
    </button>

    <ul
      id="menu-principal"
      class="menu flex items-center gap-1 max-md:flex-col max-md:items-stretch md:gap-2"
      data-menu
    >
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="flex min-h-11 items-center px-3 text-sm hover:underline" data-jump>
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="max-md:mt-2">
        <Button href={reserveLink.href} class="w-full" data-jump>{reserveLink.label}</Button>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* Mobile avec JS : menu replié en panneau sous la barre. Sans JS, il reste affiché. */
  @media (max-width: 767px) {
    :global(.js) .menu {
      position: absolute;
      top: 100%;
      inset-inline: 1rem;
      padding: 1rem;
      border-radius: 0.75rem;
      background: var(--color-veil);
      border: 1px solid var(--color-line);
    }

    :global(.js) .menu:not([data-open]) {
      display: none;
    }
  }
</style>
