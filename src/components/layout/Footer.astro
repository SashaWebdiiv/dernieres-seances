---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import FooterItem from "./FooterItem.astro";
import { footerLinks, ticketingHref } from "../../data/navigation";
import { footerColumns } from "../../data/footer";
import logoCompagnie from "../../assets/logos/acompagnie-improvisee.png";
import logoSucy from "../../assets/logos/ville-sucy.png";

const columnTitle = "font-display text-[8.8px] leading-[13.2px] tracking-[2.64px] text-creme uppercase";
const link = "text-[15.2px] leading-[22.8px] text-sable/55 hover:text-sable";
---

<!--
  Pied de page (maquette 85:3739). Placé dans la dernière scène (slot `after` de FaqScene) :
  il défile sur la même photo que la FAQ au lieu d'en afficher une seconde copie.
-->
<footer class="relative z-10 text-left">
  <div class="mx-auto max-w-360 px-5.5 pt-16 pb-12 md:px-22.75 md:pt-22.75">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
      <div class="flex flex-col items-start lg:w-62.5">
        <p class="font-display text-[19.2px] leading-[28.8px] tracking-[2.88px] text-creme">Dernières Séances</p>
        <p class="pt-2 pb-6 text-[14.4px] leading-[24.48px] whitespace-nowrap text-sable/55 italic">
          Halloween au Château de Sucy<br />28 octobre — 1er novembre 2026
        </p>
        <Button href={ticketingHref} variant="header" class="h-11.5 w-62.5 max-w-full" data-jump>J'achète mon billet !</Button>
      </div>

      <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:flex lg:w-234.75 lg:justify-between lg:gap-12">
        <nav aria-labelledby="pied-navigation">
          <p id="pied-navigation" class={columnTitle}>Navigation</p>
          <ul class="flex flex-col gap-2.5 pt-5">
            {footerLinks.map((item) => <li><a href={item.href} class={link} data-jump>{item.label}</a></li>)}
          </ul>
        </nav>

        {
          footerColumns.map((column) => (
            <div>
              <p class={columnTitle}>{column.title}</p>
              <ul class="flex flex-col gap-2.5 pt-5">
                {column.links.map((item) => (
                  <li class="break-words">
                    <FooterItem item={item} class={link} />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 h-px bg-linear-to-r from-transparent via-sable/40 to-transparent" aria-hidden="true"></div>

    <!-- Mobile : les deux logos sur une ligne, le copyright dessous. Desktop : une seule ligne (maquette). -->
    <div class="grid grid-cols-2 items-center gap-y-6 pt-6 md:flex md:justify-between md:gap-4 md:py-3.5">
      <Image src={logoCompagnie} alt="L'Acompagnie Improvisée" width={113} class="h-13.5 w-auto justify-self-start" />
      <p class="col-span-2 row-start-2 text-center font-serif text-[12.8px] leading-[19.2px] tracking-[0.64px] text-sable/30">
        © 2026 Dernières Séances — Château de Sucy-en-Brie
      </p>
      <Image src={logoSucy} alt="Sucy-en-Brie" width={113} class="h-11 w-auto justify-self-end" />
    </div>
  </div>
</footer>

