---
import { emailContact, lieu, periodeLisible } from "../../data/evenement";
---

<footer class="relative z-10 border-t border-line bg-veil px-4 py-12 text-sm text-ink-muted md:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 md:flex-row md:justify-between">
    <div class="flex flex-col gap-1">
      <p class="font-semibold text-ink">Dernières Séances — Halloween 2026</p>
      <p>{periodeLisible} · {lieu}</p>
    </div>
    <div class="flex flex-col gap-1 md:text-right">
      <a href={`mailto:${emailContact}`} class="underline-offset-4 hover:underline">{emailContact}</a>
      <p>Organisé par L'Acompagnie Improvisée · Site : <a href="https://webdiiv.com" class="underline-offset-4 hover:underline">Webdiiv</a></p>
    </div>
  </div>
</footer>
