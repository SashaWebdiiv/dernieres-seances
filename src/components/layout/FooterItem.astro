---
import type { FooterLink } from "../../data/footer";

/** Lien du pied de page ; simple texte tant que sa destination est inconnue. */
interface Props {
  item: FooterLink;
  class: string;
}

const { item, class: className } = Astro.props;
const external = item.href?.startsWith("http");
---

{
  item.href ? (
    <a href={item.href} class={className} {...(external && { target: "_blank", rel: "noopener" })}>
      {item.label}
    </a>
  ) : (
    <span class={className}>{item.label}</span>
  )
}
