---
// Section 1 — « Ouverture » (Figma : desktop 10:561 / mobile 4:337)
---

<section class="ouverture">
  <picture class="ouverture__decor">
    <source media="(min-width: 900px)" srcset="/assets/chateau-desktop.webp" />
    <img
      src="/assets/chateau-mobile.webp"
      alt=""
      width="780"
      height="1380"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="ouverture__voile" aria-hidden="true"></div>

  <div class="ouverture__contenu">
    <header class="barre">
      <img
        class="barre__logo"
        src="/assets/logo-compagnie.png"
        alt="L'Acompagnie Improvisée"
        width="360"
        height="172"
      />

      <p class="statut">
        <span class="statut__texte">
          <span class="statut__signal" aria-hidden="true"></span>
          Site en construction
        </span>
      </p>

      <img
        class="barre__partenaire"
        src="/assets/logo-sucy.png"
        alt="Sucy-en-Brie"
        width="226"
        height="88"
      />
    </header>

    <div class="titre">
      <h1 class="titre__principal">
        <img
          class="titre__annee"
          src="/assets/titre-halloween-2026.svg"
          alt="Halloween 2026"
          width="279"
          height="39"
        />
        <img
          class="titre__nom"
          src="/assets/titre-dernieres-seances.svg"
          alt="Dernières Séances"
          width="648"
          height="307"
        />
      </h1>
      <img
        class="titre__accroche"
        src="/assets/badge-oserez-vous-entrer.svg"
        alt="Oserez-vous entrer ?"
        width="237"
        height="39"
      />
    </div>

    <div class="reperes">
      <p class="reperes__dates">28 oct. — 1er nov. 2026</p>
      <p class="reperes__lieu">Château de Sucy · Sucy-en-Brie</p>
    </div>
  </div>
</section>

<style>
  /* ───────── Mobile (référence Figma : 390 × 690) ───────── */
  .ouverture {
    position: relative;
    overflow: hidden;
    min-height: 690px;
    background: var(--nuit-700);
  }

  .ouverture__decor,
  .ouverture__decor img,
  .ouverture__voile {
    position: absolute;
    inset: 0;
  }

  .ouverture__decor img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ouverture__voile {
    background: linear-gradient(
      180deg,
      rgb(4 16 26 / 0.8) 0%,
      rgb(4 16 26 / 0.33) 38%,
      rgb(3 8 13 / 0.95) 100%
    );
  }

  .ouverture__contenu {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 690px;
    padding: 20px var(--marge-mobile) 28px;
  }

  /* ── Barre supérieure ── */
  .barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 26px;
  }

  .barre__logo { width: 61px; height: 29px; }
  .barre__partenaire { width: 61px; height: 24px; }

  .statut {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgb(7 19 26 / 0.8);
    box-shadow: inset 0 0 0 1px var(--ambre);
    color: var(--ambre-clair);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .statut__texte {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .statut__signal {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--ambre);
  }

  /* ── Titre de l'événement ── */
  .titre {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    gap: 16px;
    width: 307px;
    max-width: 100%;
    margin-top: 70px;
  }

  .titre__principal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    font-size: inherit;
    font-weight: inherit;
  }

  .titre__annee { width: 53.42%; height: auto; }
  .titre__nom { width: 100%; height: auto; }
  .titre__accroche { width: 77.2%; height: auto; }

  /* ── Informations clés ── */
  .reperes {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: auto;
  }

  .reperes__dates {
    color: var(--ambre-clair);
    font-family: var(--fonte-chiffres);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .reperes__lieu {
    color: var(--creme);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.21;
    text-transform: uppercase;
  }

  /* ───────── Desktop (référence Figma : 1440 × 900) ───────── */
  @media (min-width: 900px) {
    .ouverture { min-height: 900px; }

    .ouverture__voile {
      background: linear-gradient(
        180deg,
        rgb(4 16 26 / 0.87) 0%,
        rgb(4 16 26 / 0.33) 48%,
        rgb(3 8 13 / 0.96) 100%
      );
    }

    .ouverture__contenu {
      justify-content: space-between;
      min-height: 900px;
      padding: 32px var(--marge-desktop) 64px;
    }

    .barre {
      width: 100%;
      max-width: var(--largeur-contenu);
      height: 54px;
      margin-inline: auto;
    }

    .barre__logo { width: 113px; height: 54px; }
    .barre__partenaire { width: 113px; height: 44px; }

    .statut {
      position: relative;
      align-self: stretch;
      /* Largeur figée à 170 px dans la maquette. */
      width: 170px;
      height: auto;
      padding: 0 13px;
      font-size: 10px;
      font-weight: 800;
    }

    /* Le point est sorti du flux et suspendu à gauche du texte : sans cela, ses 7 px
       plus l'écart ne pèsent que d'un côté et poussent le texte à 7 px à droite de
       l'axe du H1, alors même que le cadre de la pastille est bien centré. */
    .statut__texte {
      position: relative;
      display: block;
    }

    .statut__signal {
      position: absolute;
      top: 50%;
      right: 100%;
      width: 7px;
      height: 7px;
      margin-right: 7px;
      transform: translateY(-50%);
    }

    .titre {
      gap: 32px;
      width: 100%;
      max-width: var(--largeur-contenu);
      margin-top: 0;
    }

    .titre__principal { gap: 32px; }

    .titre__annee { width: 21.8%; }
    .titre__nom { width: 50.63%; }
    .titre__accroche { width: 18.52%; }

    .reperes {
      gap: 6px;
      width: 100%;
      max-width: var(--largeur-contenu);
      margin-top: 0;
      margin-inline: auto;
    }

    .reperes__dates {
      font-size: 34px;
    }

    .reperes__lieu {
      font-weight: 800;
    }
  }
</style>
