---
// Section 2 — « Avant l'ouverture » (Figma : desktop 10:578 / mobile 4:355)
import CompteARebours from "./CompteARebours.astro";
import { experiences, exceptionProgramme } from "../data/evenement";
---

<section class="avant">
  <CompteARebours />

  <div class="programme">
    <p class="programme__rubrique">Trois expériences · petits et grands</p>
    <h2 class="programme__titre">Choisissez votre dose de frisson</h2>

    <ul class="experiences">
      {
        experiences.map((e) => (
          <li class="experience">
            <div class="experience__entete">
              <p class="experience__age">{e.age}</p>
              <p class:list={["experience__tarif", e.tarifCompact && "experience__tarif--compact"]}>
                {e.tarif}
              </p>
            </div>
            <h3 class="experience__nom">{e.nom}</h3>
            <p class="experience__horaires">{e.horaires}</p>
          </li>
        ))
      }
    </ul>

    <p class="programme__exception">{exceptionProgramme}</p>
  </div>
</section>

<style>
  /* ───────── Mobile (référence Figma : 390 × 868) ───────── */
  .avant {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 48px var(--marge-mobile);
    background: var(--nuit-800);
  }

  .programme {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .programme__rubrique {
    color: var(--ambre);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.21;
    text-transform: uppercase;
  }

  .programme__titre {
    color: var(--creme);
    font-family: var(--fonte-titre);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.08;
  }

  .experiences {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 18px;
    border-radius: 14px;
    background: var(--panneau);
    box-shadow: inset 0 0 0 1px var(--trait);
  }

  /* Mobile : âge à gauche, tarif à droite. Sous ~330 px de large, le tarif passe
     à la ligne plutôt que de déborder de la carte. */
  .experience__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .experience__age,
  .experience__tarif {
    color: var(--ambre-clair);
    font-weight: 800;
    line-height: 1.21;
  }

  .experience__age {
    font-size: 11px;
    text-transform: uppercase;
  }

  .experience__tarif { font-size: 12px; }

  /* Libellé long : réduit dans la maquette pour tenir sur une ligne. */
  .experience__tarif--compact { font-size: 11px; }

  .experience__nom {
    color: var(--creme);
    font-family: var(--fonte-titre);
    font-size: 19px;
    font-weight: 400;
    line-height: normal;
  }

  .experience__horaires {
    color: var(--brume);
    font-size: 12px;
    line-height: 1.21;
  }

  .programme__exception {
    color: var(--brume);
    font-size: 11px;
    line-height: 1.45;
  }

  /* ───────── Desktop (référence Figma : 1440 × 815) ───────── */
  @media (min-width: 900px) {
    .avant {
      align-items: center;
      gap: 72px;
      padding: 88px var(--marge-desktop);
    }

    .programme {
      gap: 24px;
      width: 100%;
      max-width: var(--largeur-contenu);
    }

    .programme__titre {
      font-size: 52px;
      line-height: 1.05;
    }

    .experiences {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .experience {
      gap: 0;
      justify-content: space-between;
      min-height: 210px;
      padding: 24px;
    }

    /* Desktop : âge et tarif empilés à gauche. */
    .experience__entete {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .experience__age,
    .experience__tarif,
    .experience__tarif--compact {
      font-size: 11px;
      line-height: 1.21;
    }

    .experience__nom { font-size: 25px; }

    .experience__horaires { font-size: 13px; }

    .programme__exception {
      font-size: 12px;
      line-height: 1.5;
    }
  }
</style>
