---
import Scene from "./Scene.astro";
import Button from "../ui/Button.astro";
import { scenes } from "../../data/scenes";
import { ticketingHref } from "../../data/navigation";
---

<!-- Façade (maquette « Hero », 62:9). Titres vectorisés : mêmes SVG que la page d'attente. -->
<Scene scene={scenes.hero} labelledBy="titre-accueil">
  <div class="flex h-full flex-col items-center px-5.5 pt-18 pb-8 md:justify-center md:gap-8 md:pt-21.5 md:pb-16" data-hero-content>
    <!-- Titre et bouton : centrés dans l'espace libre en mobile, pour que le bouton ressorte. -->
    <div class="flex flex-1 flex-col items-center justify-center gap-4 md:flex-none md:gap-8">
      <h1 id="titre-accueil" tabindex="-1" class="flex w-76.75 max-w-full flex-col items-center gap-4 md:w-162 md:gap-8">
        <img src="/assets/titre-halloween-2026.svg" alt="Halloween 2026" width="279" height="39" class="h-auto w-[53.42%] md:w-[43.06%]" />
        <img src="/assets/titre-dernieres-seances.svg" alt="Dernières Séances" width="648" height="307" class="h-auto w-full" />
      </h1>
      <img
        src="/assets/badge-oserez-vous-entrer.svg"
        alt="Oserez-vous entrer ?"
        width="237"
        height="39"
        class="h-auto w-59.25 max-w-[77%]"
      />
      <Button href={ticketingHref} variant="header" class="mt-2 h-11.5 w-62.5 md:mt-0" data-jump>J'achète mon billet !</Button>
    </div>
    <!-- Repères : en bas de l'écran en mobile, calés à droite sous le bouton sur desktop (maquette). -->
    <div class="flex w-full max-w-320 flex-col items-center gap-1.5 md:items-end md:text-right">
      <p class="font-chiffres text-[28px] leading-[1.2] tracking-[1px] text-ambre-clair uppercase md:text-[34px]">
        28 oct. — 1er nov. 2026
      </p>
      <p class="text-sm leading-[1.21] font-extrabold tracking-[1.4px] text-ivoire uppercase">
        Château de Sucy · Sucy-en-Brie
      </p>
    </div>
  </div>
</Scene>
