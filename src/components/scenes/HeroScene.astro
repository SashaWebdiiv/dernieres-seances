---
import Scene from "./Scene.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { scenes } from "../../data/scenes";
import { lieu, periodeLisible } from "../../data/evenement";
import { reserveLink } from "../../data/navigation";
---

<Scene scene={scenes.hero} labelledBy="titre-accueil">
  <div class="flex h-full flex-col items-center justify-end gap-6 px-4 pb-14 text-center md:pb-20" data-hero-content>
    <SectionTitle id="titre-accueil" level={1} eyebrow={`Halloween 2026 · ${lieu}`}>Dernières Séances</SectionTitle>
    <p class="text-base md:text-lg">{periodeLisible}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={reserveLink.href} data-jump>{reserveLink.label}</Button>
      <Button href="#experience" variant="secondary" data-jump>Découvrir</Button>
    </div>
    <p class="text-xs uppercase tracking-[0.2em] text-ink-muted" aria-hidden="true">Défilez pour entrer</p>
  </div>
</Scene>
