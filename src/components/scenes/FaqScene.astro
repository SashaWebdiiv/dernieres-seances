---
import Scene from "./Scene.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { scenes } from "../../data/scenes";
import { faqItems } from "../../data/faq";
---

<!-- Fenêtre sur le jardin (maquette « Préparez votre visite », 85:3673). -->
<Scene scene={scenes.faq} labelledBy="titre-faq">
  <div class="mx-auto w-full max-w-220.5 px-5.5 py-20 md:px-22.75 md:py-28.5">
    <span class="mx-auto block h-px w-8 bg-sable/40" aria-hidden="true"></span>
    <SectionTitle id="titre-faq" class="pt-6 text-center">Préparez votre visite</SectionTitle>

    <div class="pt-14">
      {
        faqItems.map((item) => (
          <details class="faq-item group">
            <summary class="flex min-h-16.75 cursor-pointer list-none items-center justify-between gap-4 py-5 font-serif text-[17.6px] leading-[26.4px] tracking-[0.02em] text-creme/70 hover:text-creme">
              {item.question}
              <span
                class="grid size-4.5 shrink-0 place-items-center rounded-full border border-sable/30 font-serif text-[11.2px] leading-none text-sable transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="flex flex-col gap-2 pb-5 text-[15.2px] leading-[22.8px] text-sable/70">
              {item.answer ? (
                item.answer.map((paragraph) => <p>{paragraph}</p>)
              ) : (
                <p>[Réponse à fournir par l'organisation.]</p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Scene>

<style>
  /* Filet dégradé sous chaque question (maquette 85:3688). */
  .faq-item {
    background: linear-gradient(90deg, transparent, rgb(200 183 153 / 0.4), transparent) bottom / 100% 1px no-repeat;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
