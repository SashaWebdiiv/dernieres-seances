---
import Scene from "./Scene.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { scenes } from "../../data/scenes";
import { faqItems } from "../../data/faq";
import { insecables } from "../../utils/typographie";
---

<!-- Sous-sol (maquette « Préparez votre visite », 85:3673). Le slot reçoit le pied de page,
     qui partage la même photo que la FAQ, comme dans la maquette. -->
<Scene scene={scenes.faq} labelledBy="titre-faq">
  <div class="mx-auto w-full max-w-220.5 px-5.5 py-20 md:px-22.75 md:py-28.5">
    <span class="mx-auto block h-px w-8 bg-sable/40" aria-hidden="true"></span>
    <SectionTitle id="titre-faq" class="pt-6 text-center">Préparez votre visite</SectionTitle>

    <div class="pt-14">
      {
        faqItems.map((item) => (
          <details class="faq-item group">
            <summary class="flex min-h-16.75 cursor-pointer list-none items-center justify-between gap-4 py-5 text-[15px] leading-[24px] tracking-[0.3px] text-creme/80 hover:text-creme md:text-[17px] md:leading-[26.4px] md:tracking-[0.35px]">
              {insecables(item.question)}
              <span class="plus relative size-[19px] shrink-0 rounded-full border border-sable/30 transition-transform group-open:rotate-45" aria-hidden="true" />
            </summary>
            <div class="flex flex-col gap-2 pb-5 text-[15.2px] leading-[22.8px] text-sable/80">
              {item.answer.map((paragraph) => <p>{insecables(paragraph)}</p>)}
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <slot slot="after" />
</Scene>

<style>
  /* Filet dégradé sous chaque question (maquette 85:3688). */
  .faq-item {
    background: linear-gradient(90deg, transparent, rgb(200 183 153 / 0.4), transparent) bottom / 100% 1px no-repeat;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /*
   * « + » dessiné en CSS, centré par construction (le glyphe typographique ne l'est pas).
   * Cercle de 19 px (17 px intérieurs) et traits de 9 × 1 px : tout tombe sur des pixels entiers,
   * dans une ligne de 67 px (maquette), donc aucun flou de demi-pixel.
   */
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 4px;
    width: 9px;
    height: 1px;
    background: var(--color-sable);
  }

  .plus::after {
    transform: rotate(90deg);
  }
</style>
