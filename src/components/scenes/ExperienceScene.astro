---
import Scene from "./Scene.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { scenes } from "../../data/scenes";
import { experienceSteps } from "../../data/experiences";
---

<!--
  Première salle (maquette « Description », 67:788). Animé : les publics se relaient au même
  niveau, en alternant gauche et droite, et les points indiquent l'étape en cours.
  Statique : ils se suivent en zigzag, comme dans la maquette.
-->
<Scene scene={scenes.experiences} labelledBy="titre-programme">
  <div class="relative mx-auto flex h-full max-w-360 flex-col justify-center gap-10 px-5.5 py-24 md:gap-22.5 md:px-22.75">
    <SectionTitle id="titre-programme" class="mx-auto max-w-180 text-center opacity-82">
      Des expériences adaptées<br class="max-md:hidden" /> pour chaque public
    </SectionTitle>

    <ol class="steps">
      {
        experienceSteps.map((step, index) => (
          <li
            class:list={["col-start-1 flex max-w-90 flex-col", index % 2 === 1 && "md:col-start-2"]}
            style={{ "--row": index + 1 }}
            data-step
          >
            <p class="kicker text-rouille">{step.kicker}</p>
            <h3 class="pt-2 font-display text-[26px] leading-normal tracking-[0.06em] text-creme md:text-[32px]">
              {step.title}
            </h3>
            <span class="filet mt-3 bg-sable/40" aria-hidden="true" />
            <p class="pt-3 text-base leading-[1.7] text-sable/85 italic md:text-[16.8px]">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <ol class="dots" aria-hidden="true" data-step-dots>
      {experienceSteps.map((_, index) => <li data-active={index === 0 ? "" : undefined} />)}
    </ol>
  </div>
</Scene>

<style>
  /* Zigzag de la maquette : une étape par ligne, colonne droite à 953 px sur 1440. */
  .steps {
    display: grid;
    row-gap: 4rem;
  }

  .steps > li {
    grid-row: var(--row);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    .steps {
      grid-template-columns: minmax(0, 862fr) minmax(0, 396fr);
      column-gap: 0;
    }
  }

  .dots {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Animé : toutes les étapes sur la même ligne, chacune dans sa colonne. */
    :global(.js) .steps > li {
      grid-row: 1;
    }

    :global(.js) .dots {
      position: absolute;
      top: 50%;
      right: 57px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 9.6px;
      transform: translateY(-50%);
    }
  }

  .dots > li {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgb(200 183 153 / 0.3);
    transition:
      width 0.3s,
      height 0.3s,
      background-color 0.3s;
  }

  .dots > li[data-active] {
    width: 6px;
    height: 6px;
    background: var(--color-sable);
  }

  @media (max-width: 767px) {
    :global(.js) .dots {
      right: 12px;
    }
  }
</style>
