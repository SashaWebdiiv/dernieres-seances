---
import Scene from "./Scene.astro";
import { scenes } from "../../data/scenes";
import { partners } from "../../data/partners";
---

<!-- Escalier (maquette « Partenaire », 68:2157) : les partenaires apparaissent pendant la montée. -->
<Scene scene={scenes.partners} labelledBy="titre-partenaires">
  <div class="mx-auto flex h-full max-w-175 flex-col items-center justify-end px-5.5 pb-16 text-center md:pb-22.75">
    <h2 id="titre-partenaires" tabindex="-1" class="text-[9.6px] leading-[14.4px] tracking-[2.88px] text-sable/60 uppercase">
      Ils rendent cette expérience possible
    </h2>
    <ul class="grid w-full grid-cols-2 gap-x-4 gap-y-8 pt-10 md:grid-cols-3 md:gap-y-11.25">
      {
        partners.map((partner) => (
          <li class="text-[12px] leading-[1.5] tracking-[0.15em] uppercase md:text-[13.6px] md:leading-[20.4px]" data-reveal>
            {partner.url ? (
              <a href={partner.url} class="underline-offset-4 hover:underline">
                {partner.name}
              </a>
            ) : (
              partner.name
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Scene>
