---
import { Image } from "astro:assets";
import Scene from "./Scene.astro";
import { scenes } from "../../data/scenes";
import { partners } from "../../data/partners";
---

<!-- Escalier (maquette « Partenaire », 68:2157) : les partenaires apparaissent pendant la montée. -->
<Scene scene={scenes.partners} labelledBy="titre-partenaires">
  <div class="mx-auto flex h-full max-w-195.75 flex-col items-center justify-center px-5.5 pb-16 text-center md:pb-22.75">
    <h2 id="titre-partenaires" tabindex="-1" class="text-xs leading-[14.4px] tracking-[2.88px] text-white uppercase">
      Ils rendent cette expérience possible
    </h2>
    <ul class="flex flex-wrap justify-center gap-x-1.5 gap-y-8 pt-10 md:gap-y-11.25">
      {
        partners.map((partner) => (
          <li class="flex w-[calc(50%-3px)] flex-col items-center gap-1.5 md:w-60.5" data-reveal>
            <span class="flex h-12 items-center md:h-15" aria-hidden={partner.logo ? undefined : "true"}>
              {partner.logo && <Image src={partner.logo} alt="" height={60} densities={[1, 2]} class="h-full w-auto" />}
            </span>
            <span class="text-xs leading-[1.5] font-medium tracking-[0.15em] text-white uppercase md:text-[13.6px] md:leading-[20.4px]">
              {partner.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Scene>
