---
import { Image } from "astro:assets";
import Scene from "./Scene.astro";
import { scenes } from "../../data/scenes";
import { partners } from "../../data/partners";
---

<!-- Escalier (maquette « Partenaire », 68:2157) : les partenaires apparaissent pendant la montée. -->
<Scene scene={scenes.partners} labelledBy="titre-partenaires">
  <div class="mx-auto flex h-full max-w-195.75 flex-col items-center justify-center px-5.5 pb-16 text-center md:pb-22.75">
    <h2 id="titre-partenaires" tabindex="-1" class="text-xs leading-[14.4px] tracking-[2.88px] text-white uppercase">
      Ils rendent cette expérience possible
    </h2>
    <!-- Deux lignes de trois à toutes les largeurs : les colonnes restent alignées d'une ligne à l'autre. -->
    <ul class="grid grid-cols-3 gap-x-3 gap-y-8 pt-10 md:grid-cols-[repeat(3,minmax(0,15.125rem))] md:gap-x-1.5 md:gap-y-11.25">
      {
        partners.map((partner) => (
          <li class="flex min-w-0 flex-col items-center gap-1.5" data-reveal>
            <span class="flex h-11 items-center md:h-15" aria-hidden={partner.logo ? undefined : "true"}>
              {partner.logo && <Image src={partner.logo} alt="" height={60} densities={[1, 2]} class="h-full w-auto max-w-full object-contain" />}
            </span>
            <span class="text-[11px] leading-[1.5] font-medium tracking-[0.12em] text-balance text-white uppercase md:text-[13.6px] md:leading-[20.4px] md:tracking-[0.15em]">
              {partner.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Scene>
