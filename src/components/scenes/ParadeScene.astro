---
import { Image } from "astro:assets";
import Scene from "./Scene.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { scenes } from "../../data/scenes";
import { parade } from "../../data/parade";

/*
 * Agencement de la maquette (237:6315) ; tailles de texte alignées sur le reste du site
 * (titre de section, étiquettes New Rocker 12 px, texte courant 16 px, cartes du programme).
 * À partir de 1024 px : titre et horaires sur une ligne, associations à gauche, carte à droite.
 */
const etiquette = "font-display text-xs leading-4.5 tracking-[2.64px] uppercase";
const carte = "rounded-lg border border-sable/15 bg-noir/40";
/* Fausses lignes de l'aperçu de la carte (largeur de la première barre, maquette). */
const lignesApercu = [72, 96, 64, 88, 76, 104];

/* Clé publique (restreinte au domaine), lue au build : absente, il ne reste que le lien. */
const cleGoogleMaps: string | undefined = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || undefined;

/* Repli : le parcours à pied dans Google Maps, étapes dans l'ordre. */
const points = parade.carte.lieux.map(({ lat, lng }) => `${lat},${lng}`);
const itineraireGoogleMaps = `https://www.google.com/maps/dir/?${new URLSearchParams({
  api: "1",
  origin: points[0],
  destination: points.at(-1)!,
  waypoints: points.slice(1, -1).join("|"),
  travelmode: "walking",
})}`;
---

<!-- Jardin (maquette « Parade », 237:6315). -->
<Scene scene={scenes.parade} labelledBy="titre-parade">
  <div class="mx-auto flex w-full max-w-360 flex-col px-4 py-15 md:px-6">
    <div class="flex flex-col gap-6 rounded-lg border border-sable/15 p-3 md:p-8">
      <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-2.5">
        <SectionTitle id="titre-parade">La parade des associations</SectionTitle>
        <div class={`${carte} flex flex-col gap-2 p-4 lg:shrink-0`}>
          <p class={`${etiquette} text-ambre`}>Horaires</p>
          <p class="text-base leading-6 text-ambre">
            {parade.horaires.map((ligne) => <span class="block">{ligne}</span>)}
          </p>
        </div>
      </header>

      <div class="flex flex-col gap-6 lg:flex-row">
        <ul class="flex flex-col gap-3 lg:w-111.5 lg:shrink-0" aria-label="Associations participantes">
          {
            parade.associations.map(({ nom, logo, taille: [largeur, hauteur] }) => (
              <li class={`${carte} flex items-center gap-3 p-4`}>
                {/* Cadre commun de 64 × 64 : logos centrés, noms alignés quelle que soit la forme du logo. */}
                <div class="flex size-16 shrink-0 items-center justify-center">
                  <Image
                    src={logo}
                    alt=""
                    width={largeur}
                    height={hauteur}
                    densities={[1, 2, 3]}
                    class="object-contain"
                    style={{ width: `${largeur}px`, height: `${hauteur}px` }}
                  />
                </div>
                <span class="min-w-0 text-base leading-6 font-semibold text-creme">{nom}</span>
              </li>
            ))
          }
        </ul>

        <div class={`${carte} flex min-w-0 flex-1 flex-col gap-3 p-4`}>
          <h3 class={`${etiquette} text-ambre`}>Itinéraire</h3>
          <p class="text-base leading-6 text-sable/85">{parade.itineraire}</p>

          <!-- Carte Google Maps, chargée seulement après accord (scripts/carteParade.ts). -->
          <div
            class="flex min-h-80 flex-1 flex-col overflow-hidden rounded-lg border border-sable/15 bg-noir"
            data-carte-parade
            data-cle={cleGoogleMaps}
            data-map-id={parade.carte.mapId}
            data-lieux={JSON.stringify(parade.carte.lieux)}
          >
            <div class="flex items-center justify-between gap-3 bg-noir/60 p-3">
              <p class={`${etiquette} text-creme`}>Google Maps</p>
              <a
                href={itineraireGoogleMaps}
                target="_blank"
                rel="noopener"
                aria-label="Ouvrir le parcours dans Google Maps (nouvel onglet)"
                class={`${etiquette} shrink-0 text-sable/80 underline-offset-4 transition-colors hover:text-ambre hover:underline`}
              >
                Ouvrir<span class="max-sm:hidden"> dans Google Maps</span>
              </a>
            </div>
            <div class="relative flex-1">
              <div class="absolute inset-0" hidden data-carte-canevas></div>
              <div class="absolute inset-0" data-carte-accord>
                <div class="flex flex-col gap-3 p-3 opacity-60" aria-hidden="true">
                  {
                    lignesApercu.map((largeur, index) => (
                      <>
                        {index > 0 && <span class="h-px bg-sable/15" />}
                        <span class="flex gap-3">
                          <span class="h-3 shrink-0 rounded-md bg-sable/8" style={{ width: `${largeur}px` }} />
                          <span class="h-3 flex-1 rounded-md bg-sable/8" />
                        </span>
                      </>
                    ))
                  }
                </div>
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-noir/40 p-6 text-center">
                  <button
                    type="button"
                    hidden
                    class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-lg bg-ambre-vif px-6 text-base font-extrabold tracking-[0.05em] text-nuit transition-colors hover:bg-ambre-clair disabled:cursor-wait disabled:opacity-70"
                    data-carte-afficher
                  >
                    Afficher la carte
                  </button>
                  <p class="max-w-90 text-xs leading-4.5 text-sable/80" role="status" data-carte-statut>
                    {
                      cleGoogleMaps
                        ? "La carte est fournie par Google Maps : en l'affichant, vous acceptez que Google reçoive votre adresse IP."
                        : "Carte bientôt disponible. En attendant, ouvrez le parcours dans Google Maps."
                    }
                  </p>
                  {cleGoogleMaps && (
                    <a href="/confidentialite/#carte" class="text-xs leading-4.5 text-ambre underline underline-offset-3">
                      En savoir plus
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Scene>

<style>
  /* Pastilles des étapes, créées par le script dans la carte (hors de la portée des styles Astro). */
  :global(.carte-etape) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-noir);
    border-radius: 9999px;
    background: var(--color-ambre);
    color: var(--color-noir);
    font-size: 0.9375rem;
    font-weight: 800;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
  }
</style>

<script>
  import { initCarteParade } from "../../scripts/carteParade";

  initCarteParade();
</script>
